// Shared definitions for GPU brush paint simulation
// Based on Wetbrush (Chen et al., SIGGRAPH Asia 2015)
//
// The simulation grid is 3D: N×N×D (res × res × res_z).
// Paper lies in the XY plane; Z is the height axis for paint volume.
// Wetbrush uses 128×128×32 active window within a 4096×4096×64 global grid.

#ifndef BRUSH_SIM_COMMON
#define BRUSH_SIM_COMMON

struct SimConstants {
    int res;                // Grid XY resolution N
    float cell_size;        // paper_size / res
    float paper_size;       // Total paper extent (XY)
    float dt;               // Time step

    float viscosity;        // Viscosity coefficient
    float diffusion;        // Diffusion rate
    float drying_rate;      // Drying rate
    float brush_radius;     // Brush radius (world units)

    float ink_amount;       // Ink deposit amount
    int num_vertices;       // Number of NEW curve vertices to deposit
    float center_x;         // Grid center X (world space)
    float center_y;         // Grid center Y (world space)

    float center_z;         // Grid center Z (world space)
    float effective_radius; // max(brush_radius, cell_size * 3)
    int jacobi_mode;        // 0 = diffuse, 1 = pressure
    float jacobi_alpha;     // alpha for Jacobi: dt*rate*N^2 (diffuse) or 1.0 (pressure)

    // --- 3D grid extension ---
    int res_z;              // Grid Z (height) resolution D
    float height_extent;    // Total height extent in world units
    float grid_center_z;    // Override center_z for 3D (same as center_z usually)

    // --- Active window (Wetbrush §4.2) ---
    // The 3D buffers are now GLOBAL (res × res × res_z). The window defines
    // only the dispatch range — which cells get computed each frame. Cells
    // outside the window keep their previous values (paper §4.2: "a large 3D
    // grid stores all cells; simulation runs only inside the active window").
    // Buffer indexing is GLOBAL (idx = z*res*res + y*res + x), never
    // window-local.
    int window_origin_x;
    int window_origin_y;
    int window_origin_z;
    int window_size_x;
    int window_size_y;
    int window_size_z;

    // --- Oil density (Wetbrush §6) ---
    // Per-cell oil density field controls paint viscosity: higher oil density
    // → thinner, flatter paint; lower → thicker. The base value is the user
    // input; cells relax toward it as paint is deposited.
    float oil_density_base;
    // Threshold for the brush-interior boundary in pressure projection (paper
    // §4.2): a cell whose bristle-rasterized density exceeds this gate is
    // treated as a no-flux wall by fluid_divergence/jacobi/gradient. Set per
    // dispatch (0 disables the brush boundary). Replaces former _pad0.
    float brush_boundary_gate;
    // Per-dispatch velocity damping multiplier (fluid_damp_dry). The host
    // computes pow(frame_damp, 1/substeps) so the per-FRAME decay is
    // substep-count independent. Replaces former _pad1.
    float velocity_damp;
    // Scale on the brush velocity injected by brush_deposit into the footprint
    // cells. 1.0 smears fresh paint at full brush speed (semi-Lagrangian
    // backtraces of tens of cells per frame at res 4096); ~0.3 keeps a wet
    // directional flow without ballooning the stroke. Replaces former _pad2.
    float velocity_inject_scale;
    // field_copy_window mode: 0 = window→window (both widx), 1 = global→window
    // (read gidx, write widx), 2 = window→global (read widx, write gidx).
    int copy_mode;
    // fluid_damp_dry mode: 0 = global dispatch, wetness only; 1 = window
    // dispatch, velocity damp + dry-zero (vel at widx) + wetness (gidx).
    int damp_mode;
    // fluid_advect: 1 = field_in is a window-local buffer (velocity family,
    // sampled through window_local_idx with outside→0); 0 = global canvas
    // field. field_out is ALWAYS window-local (widx) — the host copies back.
    int advect_field_window_local;
    // Gravity (world units/s²) — external body force. Grid side: applied to
    // fluid (wet, painted) cells' velocity in fluid_damp_dry's window pass,
    // per substep, before the next projection (standard Eulerian external
    // force step; paper §4.2 "standard way"). Default from the host's env
    // WB_GRAVITY_* (physically scaled: 1 unit ≈ 27.5 cm → g ≈ 36 units/s²).
    float gravity_x;
    float gravity_y;
    float gravity_z;
};

// ============================================================
// Window-local indexing for the transient solve fields
// ============================================================
// Paper §4.2: velocity/pressure/divergence (and the scalar advect tmps) live
// ONLY inside the 128×128×res_z active window — allocating them over the
// whole global grid costs GBs (25 dense fields at res 1024) where the paper's
// window scratch is ~2MB each. Sampling a window-local field at an arbitrary
// GLOBAL cell must return 0 outside the window: there is no liquid motion
// there (§4.2: simulation runs only inside the window).
int win_field_idx(int gx, int gy, int gz,
                  int ox, int oy, int oz, int WSX, int WSZ)
{
    int lx = gx - ox, ly = gy - oy, lz = gz - oz;
    if (lx < 0 || lx >= WSX || ly < 0 || ly >= WSX || lz < 0 || lz >= WSZ)
        return -1;
    return lz * (WSX * WSX) + ly * WSX + lx;
}

// ============================================================
// Grid indexing — 3D: (res × res × res_z), row-major Z-first
// ============================================================
// Linear index for 3D cell (x, y, z) in grid of size (res, res, res_z)
uint grid_idx_3d(uint x, uint y, uint z, int res, int res_z)
{
    return z * (uint)(res * res) + y * (uint)res + x;
}

// Legacy 2D index (z=0 slice) — kept for shaders that don't need 3D yet
uint grid_idx(uint x, uint y, int res)
{
    return y * (uint)res + x;
}

// ============================================================
// Active-window thread mapping (Wetbrush §4.2)
// Dispatch threads index the window [0,window_size). This maps a window
// thread index to its global (x,y,z) cell and GLOBAL linear index into
// the global-sized buffer (res × res × res_z). Returns false if the thread
// maps outside the global grid (caller should return).
// ============================================================
struct WindowCell {
    uint x, y, z;     // global cell coordinates
    uint lx, ly, lz;  // window-local cell coordinates [0,WIN)
    uint idx;         // GLOBAL linear index into the global-sized buffer
};

bool window_map(SimConstants cb, uint window_idx, out WindowCell c)
{
    c.idx = 0; c.lx = 0; c.ly = 0; c.lz = 0; c.x = 0; c.y = 0; c.z = 0;
    int wsx = cb.window_size_x, wsy = cb.window_size_y, wsz = cb.window_size_z;
    int total = wsx * wsy * wsz;
    if (window_idx >= (uint)total) return false;

    uint wz = window_idx / (uint)(wsx * wsy);
    uint rem = window_idx % (uint)(wsx * wsy);
    uint wy = rem / (uint)wsx;
    uint wx = rem % (uint)wsx;

    int N = cb.res;
    int D = cb.res_z;
    c.x = (uint)(wx + cb.window_origin_x);
    c.y = (uint)(wy + cb.window_origin_y);
    c.z = (uint)(wz + cb.window_origin_z);

    // Clamp to global grid (window_origin may place edges past the grid)
    if (c.x >= (uint)N || c.y >= (uint)N || c.z >= (uint)D) return false;

    // Window-local coords (kept for trace-back / boundary checks in advect).
    c.lx = wx;
    c.ly = wy;
    c.lz = wz;
    // GLOBAL index: buffers are now global-sized (res × res × res_z).
    c.idx = grid_idx_3d(c.x, c.y, c.z, N, D);
    return true;
}

// Window-local index of the neighbor offset (dx,dy,dz) from a dispatched
// window cell, or -1 outside the window. The 6-neighbor stencils of the
// transient-field solvers (jacobi/divergence/gradient) address window-local
// buffers through this; -1 callers apply the shader's boundary rule.
int wnb(WindowCell c, int dx, int dy, int dz, int WSX, int WSZ)
{
    int lx = int(c.lx) + dx, ly = int(c.ly) + dy, lz = int(c.lz) + dz;
    if (lx < 0 || lx >= WSX || ly < 0 || ly >= WSX || lz < 0 || lz >= WSZ)
        return -1;
    return (lz * WSX + ly) * WSX + lx;
}

// Convert a GLOBAL grid cell (x,y,z) to a GLOBAL linear index.
// Buffers are global-sized, so any in-grid cell has a valid index. Returns
// false only if the cell is outside the global grid bounds. Used by
// deposit/bristle/particle shaders that compute global coords from world
// space then need to index into the global buffer.
bool window_local_idx(SimConstants cb, int gx, int gy, int gz, out uint lidx)
{
    int N = cb.res;
    int D = cb.res_z;
    if (gx < 0 || gx >= N || gy < 0 || gy >= N || gz < 0 || gz >= D) {
        lidx = 0u;
        return false;
    }
    lidx = grid_idx_3d((uint)gx, (uint)gy, (uint)gz, N, D);
    return true;
}

// Brightness: ||rgb||_M where M = diag(0.241, 0.691, 0.068)
// From Wetbrush Algorithm 2
// Atomic float add using CAS loop on RWByteAddressBuffer
void atomicFloatAdd(RWByteAddressBuffer buf, uint byte_offset, float value)
{
    uint old_val = buf.Load(byte_offset);
    uint new_val;
    for (;;) {
        new_val = asuint(asfloat(old_val) + value);
        uint prev;
        buf.InterlockedCompareExchange(byte_offset, old_val, new_val, prev);
        if (prev == old_val) break;
        old_val = prev;
    }
}
// NOTE: a RWStructuredBuffer<float> overload was impossible — Slang rejects
// InterlockedCompareExchange(buf[i], ...) with "must be l-value" (no CAS on
// structured-buffer elements in this Slang version). The scattered transfers
// (particle_rasterize / particle_to_grid / grid_to_particle Eq.15/16) therefore
// bind their accumulation targets as RWByteAddressBuffer and go through these
// CAS helpers, making the grid↔particle round trip exactly conservative
// (paper §5.2 Eq.15/16 conservation; the previous plain += raced and drifted
// RYB over long loops, clamped only as a band-aid at pack time). The host-side
// field buffers carry CanHaveRawViews so raw UAV bindings resolve.

// Atomic float max(buf[offset], value) via the same CAS loop.
void atomicFloatMax(RWByteAddressBuffer buf, uint byte_offset, float value)
{
    uint old_val = buf.Load(byte_offset);
    for (;;) {
        float cur = asfloat(old_val);
        if (cur >= value) break;
        uint new_val = asuint(value);
        uint prev;
        buf.InterlockedCompareExchange(byte_offset, old_val, new_val, prev);
        if (prev == old_val) break;
        old_val = prev;
    }
}

float color_brightness(float3 rgb)
{
    return sqrt(0.241 * rgb.r * rgb.r +
                0.691 * rgb.g * rgb.g +
                0.068 * rgb.b * rgb.b);
}

// RYB -> RGB (Gossett & Chen 2004)
float3 ryb_to_rgb(float r, float y, float b)
{
    float rm = 1.0 - r, ym = 1.0 - y, bm = 1.0 - b;
    return rm*ym*bm*float3(1,1,1)   + r*ym*bm*float3(1,0,0) +
           rm*y*bm*float3(1,1,0)    + rm*ym*b*float3(0.163,0.373,0.6) +
           r*y*bm*float3(1,0.5,0)   + r*ym*b*float3(0.5,0,0.5) +
           rm*y*b*float3(0,0.66,0.2) + r*y*b*float3(0.2,0.094,0.029);
}

// Brightness-preserving color mixing — Wetbrush Algorithm 2
float3 color_mix(float3 c_new_ryb, float3 c_old_ryb, float w_new, float w_old)
{
    float b_new = color_brightness(ryb_to_rgb(c_new_ryb.r, c_new_ryb.g, c_new_ryb.b));
    float b_old = color_brightness(ryb_to_rgb(c_old_ryb.r, c_old_ryb.g, c_old_ryb.b));

    float w_total = w_new + w_old;
    float3 c_prime = (w_new * c_new_ryb + w_old * c_old_ryb) / w_total;
    float b_prime  = color_brightness(ryb_to_rgb(c_prime.r, c_prime.g, c_prime.b));
    float b_dprime = (w_new * b_new + w_old * b_old) / w_total;

    if (b_prime > 1e-6f)
        return b_dprime * c_prime / b_prime;
    return c_prime;
}

// ============================================================
// Bristle model constants (Wetbrush Section 4.1)
// ============================================================
struct BristleConstants {
    int num_bristles;        // N_b (40–200)
    int verts_per_bristle;   // M (~10)
    int samples_per_bristle; // S (~32)
    float beta_B;            // damping [0, 0.1]

    float dt;
    float brush_pos_x, brush_pos_y, brush_pos_z;
    float brush_vel_x, brush_vel_y, brush_vel_z;
    float brush_angular_vel_x, brush_angular_vel_y, brush_angular_vel_z;
    float brush_rotation;    // heading angle (XY) — kept for legacy/seed use

    float brush_radius;
    float spring_k;          // stiffness
    float damping;
    int grid_res;            // XY resolution
    float cell_size;
    float paper_size;
    float grid_center_x, grid_center_y;
    // 3D extension
    int grid_res_z;          // Z resolution D
    float height_extent;     // total height in world units
    float grid_center_z;
    // Frame-origin acceleration (a_B) and angular acceleration (ω̇) for Eq.2,
    // finite-differenced on the host (rad/s² for omega_dot).
    float brush_accel_x, brush_accel_y, brush_accel_z;
    float brush_angular_accel_x, brush_angular_accel_y, brush_angular_accel_z;
    // Canvas contact (§4.1): pressure drives footprint splay; canvas_z is the
    // impenetrable paint-volume floor used by the collision constraint.
    float brush_pressure;
    float canvas_z;
    // Active-window origin/size (Wetbrush §4.2) — 3D buffers are window-sized,
    // so bristle/particle shaders that splat into grid fields must convert
    // global cell coords to window-local indices via these.
    int window_origin_x;
    int window_origin_y;
    int window_origin_z;
    int window_size_x;
    int window_size_z;
    // Brush SWEEP (anti-zebra): previous-frame brush center (grid-relative).
    // bristle_rasterize splats each sample along prev→current so fast drag
    // deposits a continuous band instead of isolated blobs per frame.
    // has_prev_brush_pos != 0 means prev is valid (first frame: no sweep).
    // sweep_steps is the number of arc sub-positions; dispatch issues
    // Nb*S*sweep_steps threads so each (sample, step) is one thread.
    float prev_brush_pos_x, prev_brush_pos_y, prev_brush_pos_z;
    int has_prev_brush_pos;
    int sweep_steps;
    float _sweep_pad0, _sweep_pad1;
    // Pen orientation (StrokeSample.orientation): brush_R0/1/2.xyz = world
    // image of local X/Y/Z (host stores mat3_cast(q) COLUMNS as rows here).
    // rot(v) = v.x*brush_R0.xyz + v.y*brush_R1.xyz + v.z*brush_R2.xyz —
    // avoids float3x3 mul() row/column ambiguity. Local frame: -Z = root→tip,
    // XY = root disk. Identity = the pre-orientation hardcoded upright brush.
    // MUST mirror brush_sim_common.hpp BristleConstants field-for-field.
    float4 brush_R0;
    float4 brush_R1;
    float4 brush_R2;
};

// ============================================================
// Per-sample local frame (Wetbrush §4.1 — minimal twist / Bishop frame)
// Packed as float4 to avoid RWStructuredBuffer<float3> stride hazards.
// The .w channels carry the local-frame angular velocity omega_L.
// Columns (tangent, normal, binormal) form the rotation R_L from canvas
// frame into the sample's local frame.
// ============================================================
struct SampleFrame {
    float4 tangent;   // xyz = tangent (along bristle), w = omega_L.x
    float4 normal;    // xyz = normal,                 w = omega_L.y
    float4 binormal;  // xyz = binormal,               w = omega_L.z
};

// ============================================================
// Minimal-twist (Bishop / parallel-transport) frame utilities.
// Given the previous frame (t0,n0,b0) and a new tangent t1, produce the
// rotated frame (t1,n1,b1) by parallel-transporting n0/b0 onto the plane
// orthogonal to t1. This is the rotation-minimizing frame (Bishop 1975,
// Bergou et al. 2008 "Discrete Elastic Rods") the paper refers to.
// ============================================================

// First frame from an initial tangent: pick any stable normal orthogonal
// to t0 (Wang et al. 2008 "Robust and Rotation Minimizing Frame").
void init_frame(float3 t0, out float3 n0, out float3 b0)
{
    float3 abs_t = abs(t0);
    float3 ref = (abs_t.x <= abs_t.y && abs_t.x <= abs_t.z) ? float3(1,0,0)
              : (abs_t.y <= abs_t.z)                     ? float3(0,1,0)
              :                                            float3(0,0,1);
    n0 = normalize(cross(ref, t0));
    b0 = cross(t0, n0);
}

// Parallel-transport (n_prev, b_prev) onto the plane normal to t_cur.
// Returns the updated (n_cur, b_cur); t_cur is assumed already normalized.
void parallel_transport(float3 n_prev, float3 b_prev, float3 t_cur,
                        out float3 n_cur, out float3 b_cur)
{
    float3 n_proj = n_prev - t_cur * dot(n_prev, t_cur);
    float n_len2 = dot(n_proj, n_proj);
    if (n_len2 > 1e-12f) {
        n_cur = n_proj / sqrt(n_len2);
    } else {
        // n_prev collapsed onto t_cur — pick a fresh orthogonal vector
        float3 abs_t = abs(t_cur);
        float3 ref = (abs_t.x <= abs_t.y && abs_t.x <= abs_t.z) ? float3(1,0,0)
                  : (abs_t.y <= abs_t.z)                     ? float3(0,1,0)
                  :                                            float3(0,0,1);
        n_cur = normalize(cross(ref, t_cur));
    }
    b_cur = cross(t_cur, n_cur);
}

// ============================================================
// FLIP/PIC particle constants (Wetbrush Section 4.3)
// ============================================================
struct ParticleConstants {
    int max_particles;       // pool capacity
    float dt;
    float D0;                // bristle proximity distance (Table 1: 1cm)
    float friction_delta;    // delta in Eq.8

    float flip_gamma;        // 0.8 (PIC/FLIP blend)
    int grid_res;            // XY resolution
    int grid_res_z;          // Z resolution D
    float cell_size;
    float paper_size;
    float height_extent;     // z extent
    float grid_center_x, grid_center_y, grid_center_z;
    float brush_pos_x, brush_pos_y, brush_pos_z;
    float brush_radius;
    int emit_mode;           // 0 = bristle samples, 1 = grid cells
    float D1;                // adhesion range (Table 1: 0.3cm)
    int num_bristles;        // for nearest-sample lookup
    int samples_per_bristle; // for nearest-sample lookup
    // Eq.9 frame-origin acceleration a_L and angular acceleration ω̇_L for the
    // local-frame non-inertial terms (finite-differenced on the host).
    float brush_accel_x, brush_accel_y, brush_accel_z;
    float brush_angular_accel_x, brush_angular_accel_y, brush_angular_accel_z;
    // Active-window origin/size (Wetbrush §4.2) — 3D buffers are window-sized.
    int window_origin_x;
    int window_origin_y;
    int window_origin_z;
    int window_size_x;
    int window_size_z;
    // Pen state (from deposit's BrushPoint): pen-up = brush away from the
    // canvas. particle_to_grid then deposits slow particles regardless of
    // d_{B,k} (a lifted brush is beyond D0 of everything); grid_to_particle
    // suspends conversion.
    int pen_down;
    // Brush linear velocity (canvas frame, units/s) for the Eq.9/10 two-step:
    // the local frame of the closest bristle sample TRANSLATES with the
    // brush, so Step A must convert in with the sample's previous position
    // (origin − v·dt) and out with the current one — otherwise the brush's
    // translation cancels and adhesion never carries particles along.
    float brush_vel_x, brush_vel_y, brush_vel_z;
    // §5.2 "moves slowly" — the paper gives no number; this is the absolute
    // canvas-frame speed below which a particle beyond D0 is grid liquid.
    // Derived from real units: ~2 cm/s at paper_size = 1 unit ≈ 27 cm
    // (brush radius 0.55 cm scaled to our 0.02).
    float slow_deposit_speed;
    // Gravity (world units/s²) for particle_update's external acceleration
    // (§4.3: a_k "including the gravity and the friction"). Physically
    // scaled: 1 unit ≈ 27.5 cm → g = 981 cm/s² / 27.5 ≈ 35.7 units/s². The
    // old hardcoded -0.2 was ~180× weaker than real gravity — flung
    // particles hovered in slow motion and deposited mid-air (the blob
    // test's hovering ink). Host env: WB_GRAVITY_X/Y/Z.
    float gravity_x;
    float gravity_y;
    float gravity_z;
};

// ============================================================
// Smoothing kernels (2D and 3D) for grid↔particle transfer
// Gaussian-like: W(r,h) = exp(-r²/(2h²)) / norm
// ============================================================
// 2D: norm = π h² (kept for legacy shaders)
float W_smooth(float2 r, float h)
{
    float r2 = dot(r, r);
    float h2 = h * h;
    return exp(-r2 / (2.0 * h2)) / (3.14159265 * h2);
}

// 3D: norm = (2π)^(3/2) h³ = 15.7496... h³ when properly normalized
// Simplified Gaussian: W(r,h) = exp(-r²/(2h²)) / (2π h²)^(3/2)
float W_smooth_3d(float3 r, float h)
{
    float r2 = dot(r, r);
    float h2 = h * h;
    float norm = 2.5066283 * h * 2.5066283 * h * 2.5066283 * h; // (2π)^(3/2) h^3
    return exp(-r2 / (2.0 * h2)) / norm;
}

// ============================================================
// Bristle sample liquid load (Wetbrush Section 5.1)
// Each sample stores: mass m_j and pigment c_j
// ============================================================
struct SampleLiquid {
    float mass;              // m_j: current liquid load
    float3 pigment;          // c_j: RYB pigment color
};

// ============================================================
// Bristle-Particle liquid transfer constants (Section 5.1)
// ============================================================
struct BristleLiquidConstants {
    int num_bristles;
    int samples_per_bristle;
    float mu;                // capacity control param (Table 1: 0.5)
    float M_max;             // max sample capacity
    float M_min;             // min sample capacity
    float rho_0;             // reference paint density (1e3 kg/m³)
    float eps_emit;          // emission epsilon (Table 1: 0.1)
    int max_emit_per_step;
    int grid_res;            // XY resolution
    int grid_res_z;          // Z resolution
    float cell_size;
    float paper_size;
    float height_extent;
    float grid_center_x, grid_center_y, grid_center_z;
    float D0;                // grid-particle conversion distance
    int max_particles;       // for slot wrap in EMIT
    // Global per-step particle-creation budget (EMIT pass). The paper's
    // per-sample limit (max_emit_per_step) bounds ONE sample; with 76800
    // samples all overloading every frame (supply drip) that still floods
    // the pool (~76k births/frame vs 262k slots). EMIT atomically reserves
    // from the budget buffer and keeps the sample's load when it is spent.
    int emit_budget;         // max NEW particles per step, 0 = unlimited
    // Brush world position — per-frame entropy for the EMIT budget's
    // probabilistic pre-gate (see bristle_liquid_transfer.slang).
    float brush_pos_x;
    float brush_pos_y;
    float brush_pos_z;
    // Active-window origin/size (Wetbrush §4.2) — 3D buffers are window-sized.
    int window_origin_x;
    int window_origin_y;
    int window_origin_z;
    int window_size_x;
    int window_size_z;
    // 1 = dip frame (stroke_start): ABSORB initializes m_j = M'_j(ψ) (Eq.12
    // with the current crowding) — "dipped full" means full to the capacity
    // the bristle geometry actually allows, not the uncrowded M_max.
    int dip_frame;
};

#endif
