// Shared definitions for GPU brush paint simulation
// Based on Wetbrush (Chen et al., SIGGRAPH Asia 2015)
//
// The simulation grid is 3D: N×N×D (res × res × res_z).
// Paper lies in the XY plane; Z is the height axis for paint volume.
// Wetbrush uses 128×128×32 active window within a 4096×4096×64 global grid.

#ifndef BRUSH_SIM_COMMON
#define BRUSH_SIM_COMMON

struct SimConstants {
    int res;                // Grid XY resolution N
    float cell_size;        // paper_size / res
    float paper_size;       // Total paper extent (XY)
    float dt;               // Time step

    float viscosity;        // Viscosity coefficient
    float diffusion;        // Diffusion rate
    float drying_rate;      // Drying rate
    float brush_radius;     // Brush radius (world units)

    float ink_amount;       // Ink deposit amount
    int num_vertices;       // Number of NEW curve vertices to deposit
    float center_x;         // Grid center X (world space)
    float center_y;         // Grid center Y (world space)

    float center_z;         // Grid center Z (world space)
    float effective_radius; // max(brush_radius, cell_size * 3)
    int jacobi_mode;        // 0 = diffuse, 1 = pressure
    float jacobi_alpha;     // alpha for Jacobi: dt*rate*N^2 (diffuse) or 1.0 (pressure)

    // --- 3D grid extension ---
    int res_z;              // Grid Z (height) resolution D
    float height_extent;    // Total height extent in world units
    float grid_center_z;    // Override center_z for 3D (same as center_z usually)
    int _pad;
};

// ============================================================
// Grid indexing — 3D: (res × res × res_z), row-major Z-first
// ============================================================
// Linear index for 3D cell (x, y, z) in grid of size (res, res, res_z)
uint grid_idx_3d(uint x, uint y, uint z, int res, int res_z)
{
    return z * (uint)(res * res) + y * (uint)res + x;
}

// Legacy 2D index (z=0 slice) — kept for shaders that don't need 3D yet
uint grid_idx(uint x, uint y, int res)
{
    return y * (uint)res + x;
}

// Brightness: ||rgb||_M where M = diag(0.241, 0.691, 0.068)
// From Wetbrush Algorithm 2
// Atomic float add using CAS loop on RWByteAddressBuffer
void atomicFloatAdd(RWByteAddressBuffer buf, uint byte_offset, float value)
{
    uint old_val = buf.Load(byte_offset);
    uint new_val;
    for (;;) {
        new_val = asuint(asfloat(old_val) + value);
        uint prev;
        buf.InterlockedCompareExchange(byte_offset, old_val, new_val, prev);
        if (prev == old_val) break;
        old_val = prev;
    }
}

float color_brightness(float3 rgb)
{
    return sqrt(0.241 * rgb.r * rgb.r +
                0.691 * rgb.g * rgb.g +
                0.068 * rgb.b * rgb.b);
}

// RYB -> RGB (Gossett & Chen 2004)
float3 ryb_to_rgb(float r, float y, float b)
{
    float rm = 1.0 - r, ym = 1.0 - y, bm = 1.0 - b;
    return rm*ym*bm*float3(1,1,1)   + r*ym*bm*float3(1,0,0) +
           rm*y*bm*float3(1,1,0)    + rm*ym*b*float3(0.163,0.373,0.6) +
           r*y*bm*float3(1,0.5,0)   + r*ym*b*float3(0.5,0,0.5) +
           rm*y*b*float3(0,0.66,0.2) + r*y*b*float3(0.2,0.094,0.029);
}

// Brightness-preserving color mixing — Wetbrush Algorithm 2
float3 color_mix(float3 c_new_ryb, float3 c_old_ryb, float w_new, float w_old)
{
    float b_new = color_brightness(ryb_to_rgb(c_new_ryb.r, c_new_ryb.g, c_new_ryb.b));
    float b_old = color_brightness(ryb_to_rgb(c_old_ryb.r, c_old_ryb.g, c_old_ryb.b));

    float w_total = w_new + w_old;
    float3 c_prime = (w_new * c_new_ryb + w_old * c_old_ryb) / w_total;
    float b_prime  = color_brightness(ryb_to_rgb(c_prime.r, c_prime.g, c_prime.b));
    float b_dprime = (w_new * b_new + w_old * b_old) / w_total;

    if (b_prime > 1e-6f)
        return b_dprime * c_prime / b_prime;
    return c_prime;
}

// ============================================================
// Bristle model constants (Wetbrush Section 4.1)
// ============================================================
struct BristleConstants {
    int num_bristles;        // N_b (40–200)
    int verts_per_bristle;   // M (~10)
    int samples_per_bristle; // S (~32)
    float beta_B;            // damping [0, 0.1]

    float dt;
    float brush_pos_x, brush_pos_y, brush_pos_z;
    float brush_vel_x, brush_vel_y, brush_vel_z;
    float brush_angular_vel;
    float brush_rotation;    // radians

    float brush_radius;
    float spring_k;          // stiffness
    float damping;
    int grid_res;            // XY resolution
    float cell_size;
    float paper_size;
    float grid_center_x, grid_center_y;
    // 3D extension
    int grid_res_z;          // Z resolution D
    float height_extent;     // total height in world units
    float grid_center_z;
};

// ============================================================
// FLIP/PIC particle constants (Wetbrush Section 4.3)
// ============================================================
struct ParticleConstants {
    int max_particles;       // pool capacity
    float dt;
    float D0;                // bristle proximity distance (Table 1: 1cm)
    float friction_delta;    // delta in Eq.8

    float flip_gamma;        // 0.8 (PIC/FLIP blend)
    int grid_res;            // XY resolution
    int grid_res_z;          // Z resolution D
    float cell_size;
    float paper_size;
    float height_extent;     // z extent
    float grid_center_x, grid_center_y, grid_center_z;
    float brush_pos_x, brush_pos_y, brush_pos_z;
    float brush_radius;
    int emit_mode;           // 0 = bristle samples, 1 = grid cells
    float D1;                // adhesion range (Table 1: 0.3cm)
    float brush_angular_vel_z;
};

// ============================================================
// Smoothing kernels (2D and 3D) for grid↔particle transfer
// Gaussian-like: W(r,h) = exp(-r²/(2h²)) / norm
// ============================================================
// 2D: norm = π h² (kept for legacy shaders)
float W_smooth(float2 r, float h)
{
    float r2 = dot(r, r);
    float h2 = h * h;
    return exp(-r2 / (2.0 * h2)) / (3.14159265 * h2);
}

// 3D: norm = (2π)^(3/2) h³ = 15.7496... h³ when properly normalized
// Simplified Gaussian: W(r,h) = exp(-r²/(2h²)) / (2π h²)^(3/2)
float W_smooth_3d(float3 r, float h)
{
    float r2 = dot(r, r);
    float h2 = h * h;
    float norm = 2.5066283 * h * 2.5066283 * h * 2.5066283 * h; // (2π)^(3/2) h^3
    return exp(-r2 / (2.0 * h2)) / norm;
}

// ============================================================
// Bristle sample liquid load (Wetbrush Section 5.1)
// Each sample stores: mass m_j and pigment c_j
// ============================================================
struct SampleLiquid {
    float mass;              // m_j: current liquid load
    float3 pigment;          // c_j: RYB pigment color
};

// ============================================================
// Bristle-Particle liquid transfer constants (Section 5.1)
// ============================================================
struct BristleLiquidConstants {
    int num_bristles;
    int samples_per_bristle;
    float mu;                // capacity control param (Table 1: 0.5)
    float M_max;             // max sample capacity
    float M_min;             // min sample capacity
    float rho_0;             // reference paint density (1e3 kg/m³)
    float eps_emit;          // emission epsilon (Table 1: 0.1)
    int max_emit_per_step;
    int grid_res;            // XY resolution
    int grid_res_z;          // Z resolution
    float cell_size;
    float paper_size;
    float height_extent;
    float grid_center_x, grid_center_y, grid_center_z;
    float D0;                // grid-particle conversion distance
    int max_particles;       // for slot wrap in EMIT
};

#endif
