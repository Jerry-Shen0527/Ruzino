# Key light: distant, from upper-left-front. -Z column = light travel dir.
def DistantLight "Sun"
{
    float inputs:intensity = 3.0
    matrix4d xformOp:transform = ( (0.8320502943378436,-0.3863631272626171,0.3980148760839957,0), (0,0.717531522059146,0.6965260331469924,0), (-0.5547001962252291,-0.5795446908939256,0.5970223141259935,0), (0,0,0,1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

# Ambient fill: procedural sky dome so shadowed sides of the glass spheres
# receive environment light (avoids the "black interior" from one-bounce
# direct lighting only). Low intensity so the key light still dominates.
def DomeLight "Sky"
{
    float inputs:intensity = 0.6
    string inputs:shader_path = "callables/eval_dome_light_procedural_sky.slang"
}
