<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="standard_surface_metallic" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ss_metal" />
  </surfacematerial>
  <standard_surface name="ss_metal" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" value="0.9, 0.7, 0.3" />
    <input name="metalness" type="float" value="1" />
    <input name="specular" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.2" />
  </standard_surface>
</materialx>
