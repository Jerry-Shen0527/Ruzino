<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="standard_surface_red" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ss_red" />
  </surfacematerial>
  <standard_surface name="ss_red" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" value="1, 0.1, 0.1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" value="0.3" />
  </standard_surface>
</materialx>
